diff --git a/src/CliReader/TransformFirstBlockRunner.cs b/src/CliReader/TransformFirstBlockRunner.cs
new file mode 100644
index 0000000..015667a
--- /dev/null
+++ b/src/CliReader/TransformFirstBlockRunner.cs
@@ -0,0 +1,76 @@
+using System.Numerics;
+using System.Text.Json;
+using Replay.Encoding.Archives;
+using Replay.Encoding.PayloadEncryption;
+using Replay.Encoding.PayloadEncryption.VersionedTransforms;
+
+namespace CliReader;
+
+internal static class TransformFirstBlockRunner
+{
+    public static int Run(string rawHex, uint seed, string? expectedHex)
+    {
+        byte[] raw;
+        byte[]? expected = null;
+        try
+        {
+            raw = Convert.FromHexString(rawHex);
+            expected = expectedHex is null ? null : Convert.FromHexString(expectedHex);
+        }
+        catch (FormatException exception)
+        {
+            Console.Error.WriteLine(exception.Message);
+            return 2;
+        }
+
+        if (raw.Length < 8 || (expected is not null && expected.Length != 8))
+        {
+            Console.Error.WriteLine("raw-hex must contain at least eight bytes; --expected must contain exactly eight.");
+            return 2;
+        }
+
+        IPayloadTransform[] transforms =
+        [
+            new ValorantSeededTransform12_10(),
+            new ValorantSeededTransform12_11(),
+            new ValorantSeededTransform13_00(),
+            new ValorantSeededTransform13_01(),
+            new ValorantSeededTransform13_02(),
+            new ValorantSeededTransform13_04(),
+            new ValorantSeededTransform13_05(),
+        ];
+        var results = transforms.Select(transform => Probe(transform, raw, seed, expected)).ToArray();
+        Console.WriteLine(JsonSerializer.Serialize(new
+        {
+            seed,
+            ciphertext_hex = Convert.ToHexString(raw.AsSpan(0, 8)),
+            expected_plaintext_hex = expectedHex?.ToUpperInvariant(),
+            candidates = results,
+        }, new JsonSerializerOptions { WriteIndented = true }));
+        return 0;
+    }
+
+    private static object Probe(IPayloadTransform transform, byte[] raw, uint seed, byte[]? expected)
+    {
+        var output = new byte[8];
+        using var input = new BitArchiveReader(raw.AsMemory(0, 8), 64);
+        transform.Apply(input, 64, seed, output);
+        var commonPrefixBytes = expected is null
+            ? (int?)null
+            : output.Zip(expected).TakeWhile(pair => pair.First == pair.Second).Count();
+        var hammingDistanceBits = expected is null
+            ? (int?)null
+            : output.Zip(expected).Sum(pair => BitOperations.PopCount((uint)(pair.First ^ pair.Second)));
+        return new
+        {
+            transform = transform.GetType().Name,
+            replay_versions = transform.SupportedReplayVersions,
+            decoded_hex = Convert.ToHexString(output),
+            exact_match = expected is null ? (bool?)null : output.SequenceEqual(expected),
+            common_prefix_bytes = commonPrefixBytes,
+            hamming_distance_bits = hammingDistanceBits,
+            zero_byte_count = output.Count(value => value == 0),
+            high_byte_count = output.Count(value => value >= 0x80),
+        };
+    }
+}
