+++ b/src/Replay.Unreal/Bunches/Payload/TransformSampleWriter.cs
@@ -0,0 +1,132 @@
+using System.Text.Json;
+using Replay.Encoding.Archives;
+using Replay.Models.Events;
+
+namespace Replay.Unreal.Bunches.Payload;
+
+internal sealed record PendingTransformSample(
+    string ReplayFile,
+    string ReplayBranch,
+    float TimeSeconds,
+    int PacketId,
+    uint ChannelIndex,
+    uint ActorNetGuid,
+    uint ObjectNetGuid,
+    string? ExportGroupPath,
+    string? ClassPath,
+    int PayloadBitCount,
+    uint Seed,
+    string RawCiphertextHex,
+    string SelectedTransform);
+
+internal sealed class TransformSampleWriter
+{
+    private readonly string _outputPath;
+    private readonly string _replayFile;
+    private readonly int _maxSamples;
+    private int _sampleCount;
+
+    public TransformSampleWriter(TransformDiagnosticOptions options)
+    {
+        _outputPath = Path.GetFullPath(options.OutputPath);
+        _replayFile = Path.GetFileName(options.ReplayPath);
+        _maxSamples = options.MaxSamples;
+        var directory = Path.GetDirectoryName(_outputPath);
+        if (!string.IsNullOrEmpty(directory))
+        {
+            Directory.CreateDirectory(directory);
+        }
+
+        File.WriteAllText(_outputPath, string.Empty);
+    }
+
+    public PendingTransformSample? Begin(
+        FBitArchive payload,
+        int payloadBitCount,
+        string replayBranch,
+        float timeSeconds,
+        int packetId,
+        uint channelIndex,
+        uint actorNetGuid,
+        uint objectNetGuid,
+        string? exportGroupPath,
+        string? classPath,
+        string selectedTransform)
+    {
+        if (_sampleCount >= _maxSamples || payloadBitCount <= 0)
+        {
+            return null;
+        }
+
+        _sampleCount++;
+        var rawBytes = CopyBits(payload, payloadBitCount);
+        return new PendingTransformSample(
+            _replayFile,
+            replayBranch,
+            timeSeconds,
+            packetId,
+            channelIndex,
+            actorNetGuid,
+            objectNetGuid,
+            exportGroupPath,
+            classPath,
+            payloadBitCount,
+            checked((uint)payloadBitCount) ^ actorNetGuid,
+            Convert.ToHexString(rawBytes),
+            selectedTransform);
+    }
+
+    public void Complete(
+        PendingTransformSample? sample,
+        byte[]? decodedBytes,
+        int parsedBits,
+        int decodedFieldCount,
+        IReadOnlyList<DecodedReplayField> diagnosticFields,
+        Exception? exception = null)
+    {
+        if (sample is null)
+        {
+            return;
+        }
+
+        var line = JsonSerializer.Serialize(new
+        {
+            replay_file = sample.ReplayFile,
+            replay_branch = sample.ReplayBranch,
+            time_seconds = sample.TimeSeconds,
+            packet_id = sample.PacketId,
+            channel_index = sample.ChannelIndex,
+            actor_net_guid = sample.ActorNetGuid,
+            object_net_guid = sample.ObjectNetGuid,
+            export_group_path = sample.ExportGroupPath,
+            class_path = sample.ClassPath,
+            payload_bit_count = sample.PayloadBitCount,
+            seed = sample.Seed,
+            raw_ciphertext_hex = sample.RawCiphertextHex,
+            selected_transform = sample.SelectedTransform,
+            decoded_hex = decodedBytes is null ? null : Convert.ToHexString(decodedBytes),
+            parsed_bits = parsedBits,
+            decoded_field_count = decodedFieldCount,
+            diagnostic_fields = diagnosticFields.Select(field => new
+            {
+                handle = field.Handle,
+                name = field.Name,
+                export_name = field.ExportName,
+                categories = field.Categories.ToString(),
+                value_kind = field.Value.Kind.ToString(),
+            }),
+            malformed = exception is not null,
+            exception_type = exception?.GetType().FullName,
+            exception_message = exception?.Message,
+        });
+        File.AppendAllText(_outputPath, line + Environment.NewLine);
+    }
+
+    public static byte[] CopyBits(FBitArchive archive, int bitCount)
+    {
+        var bytes = new byte[(bitCount + 7) / 8];
+        archive.CopyBitsTo(bytes, bitCount);
+        archive.Seek(-bitCount, SeekOrigin.Current);
+        return bytes;
+    }
+}
