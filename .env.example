# Required only when the coaching Agent is enabled.
# openai | anthropic | deepseek | openai-compatible
VALCOACH_LLM_PROVIDER=openai
VALCOACH_LLM_MODEL=your-model-id

# Use the provider-specific variable, or VALCOACH_LLM_API_KEY for any provider.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# VALCOACH_LLM_API_KEY=

# Required for openai-compatible; optional override for other providers.
# VALCOACH_LLM_BASE_URL=https://example.com/v1
VALCOACH_LLM_MAX_OUTPUT_TOKENS=4096

# Optional current prices. When both are set, ValCoach records estimated micro-USD.
# Price unit is USD per one million tokens; do not assume prices across model updates.
# VALCOACH_LLM_INPUT_USD_PER_MILLION=0
# VALCOACH_LLM_OUTPUT_USD_PER_MILLION=0
